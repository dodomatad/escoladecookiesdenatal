{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/principal", "destination": "/principal.html" },
    { "source": "/completo", "destination": "/completo.html" },
    { "source": "/membros", "destination": "/completo.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
